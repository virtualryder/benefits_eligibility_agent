        <mxCell id="n11" value="&lt;b style=&quot;font-size:19px&quot;&gt;Aegis governed-agent architecture — what is actually verified&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Benefits eligibility pack · from-zero gate run &lt;b&gt;ben-fpg&lt;/b&gt; (2026-09-10), us-east-1, single account · AWS account id redacted to 111122223333 throughout&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1560" height="46" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;How to read this.&lt;/b&gt; Green = demonstrated on a from-zero live run and named by the gate check that proves it. Amber = the code exists and is unit-tested, but no live run has demonstrated it. Grey = deliberately not ours: stubbed in the manifest, or the adopter&#x27;s to own. A picture that showed only the green boxes would be a sales diagram, not an architecture.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#f4f7fa;strokeColor=#b8c6d4;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1560" height="30" as="geometry"/></mxCell>
        <mxCell id="n13" value="Identity plane" style="fillColor=none;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#33546f;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Corporate IdP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Okta / Entra / Ping — OIDC or SAML&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;○ ADOPTER-OWNED / STUBBED · reference: deploy_federation.sh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#8a8a8a;fontColor=#3a3a3a;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="290" height="62" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Cognito user pool + groups&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;benefits_caseworker · tools_granted · tenant_*&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · outputs_present&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="60" y="258" width="290" height="66" as="geometry"/></mxCell>
