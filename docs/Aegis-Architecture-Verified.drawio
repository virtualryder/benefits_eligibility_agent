        <mxCell id="n17" value="&lt;font style=&quot;font-size:9px;color:#555&quot;&gt;Two proof users per run, removed at teardown.&lt;/font&gt;" style="text;html=1;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="434" width="290" height="20" as="geometry"/></mxCell>
        <mxCell id="n18" value="Workload account — VPC, private subnets" style="fillColor=none;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#33546f;" vertex="1" parent="1"><mxGeometry x="400" y="130" width="700" height="600" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;AgentCore Gateway (MCP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CUSTOM_JWT authorizer · allow-lists exactly one client&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · G111_consolidated_gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="425" y="172" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Cedar policy engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deny-by-default · forbid wins over permit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · CONN_governed_sor_proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="760" y="172" width="315" height="66" as="geometry"/></mxCell>
        <mxCell id="n21" value="&lt;b&gt;Gateway request interceptor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tenant DERIVED from the verified identity · consent / purpose / budget_ok stripped from the caller and injected server-side · kill switch read FIRST, fail-closed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · KS_kill_switch_proof · BUD_budget_proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="425" y="268" width="650" height="62" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;AgentCore Runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Strands agent · IaC-provisioned role · MMDSv2 required&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · RT2_runtime_ready · RT2_runtime_mmdsv2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="425" y="360" width="300" height="66" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Bedrock model + Guardrail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;every runtime row guardrail-assessed (20 of 20)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · RT2_runtime_calls_guardrail_assessed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="315" height="66" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;Tool Lambdas (private subnets)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;intake_application · mask_pii (Comprehend) · assess_eligibility · redetermine · overpayment · write_audit · request_signoff / approve_signoff&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · E2E_zero_unexpected · LIN_case_driven&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="425" y="456" width="650" height="80" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;VPC endpoints (PrivateLink)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bedrock-runtime · comprehend · states · kms · ssm · ddb · s3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;● SHIPPED, NOT PROVEN LIVE · private mode gated separately (ben-t1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#ffe6cc;strokeColor=#b06a00;" vertex="1" parent="1"><mxGeometry x="425" y="566" width="315" height="62" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;Org SCP + VPC-endpoint policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;denies direct model calls and evidence deletion org-wide&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;○ ADOPTER-OWNED / STUBBED · ships under org/; org enforcement is the adopter&#x27;s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#8a8a8a;fontColor=#3a3a3a;" vertex="1" parent="1"><mxGeometry x="760" y="566" width="315" height="62" as="geometry"/></mxCell>
        <mxCell id="n27" value="CONN-1 — governed outbound to a system of record" style="fillColor=none;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#33546f;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="700" height="250" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;verify_source Lambda&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;holds NO client secret · exposed as a gateway target&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · CONN_deploy (artifacts + rc + outbound)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="425" y="800" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;AgentCore Identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;token vault · workload identity → M2M client_credentials&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · CONN_governed_sor_proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="315" height="70" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;MOCK system of record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;API Gateway + Lambda · OAuth2 · full RS256/JWKS signature verification against the live public keys&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · rejects no-token and bad-token 401&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="425" y="900" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="n31" value="&lt;b&gt;connect_system_of_record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the real state benefits SoR — EIV, The Work Number, a state system&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;○ ADOPTER-OWNED / STUBBED · STUBBED in the manifest, on purpose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#8a8a8a;fontColor=#3a3a3a;" vertex="1" parent="1"><mxGeometry x="760" y="900" width="315" height="80" as="geometry"/></mxCell>
        <mxCell id="n32" value="Governance &amp; evidence" style="fillColor=none;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#33546f;" vertex="1" parent="1"><mxGeometry x="1130" y="130" width="470" height="440" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;b&gt;DynamoDB audit ledger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;append-only hash chain · CMK · per-tenant store&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · G111_consolidated_gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="172" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n34" value="&lt;b&gt;S3 WORM bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Object Lock COMPLIANCE · CMK · a commit requires the WORM copy&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · evidence.is_durable, core 1.10.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="246" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Step Functions sign-off&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;separation of duties · exactly-once FINAL# marker · no self-commit&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · G111_consolidated_gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="320" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n36" value="&lt;b&gt;Customer-managed KMS key&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rotate · audit · revoke&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · ben-t1 CMK re-gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="394" width="430" height="54" as="geometry"/></mxCell>
        <mxCell id="n37" value="&lt;b&gt;Separate governance / audit account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;operators of the agent cannot rewrite history&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;○ ADOPTER-OWNED / STUBBED · target topology; this gate runs single-account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#eeeeee;strokeColor=#8a8a8a;fontColor=#3a3a3a;" vertex="1" parent="1"><mxGeometry x="1150" y="462" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n38" value="Observability &amp; containment" style="fillColor=none;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#33546f;" vertex="1" parent="1"><mxGeometry x="1130" y="600" width="470" height="410" as="geometry"/></mxCell>
        <mxCell id="n39" value="&lt;b&gt;aegis.call structured log&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one line per tool invocation, correlation set hashed into every WORM record&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · LIN_zero_orphans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="642" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n40" value="&lt;b&gt;CloudTrail management events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;InvokeModel / Converse captured account-wide&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · LIN_zero_orphans: 11 invokes, 11 aegis, 0 orphans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="716" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n41" value="&lt;b&gt;Kill switch (SSM, 15 s TTL)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;containment precedes evaluation · 403 + DENIED WORM record&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · KS_kill_switch_proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="790" width="430" height="62" as="geometry"/></mxCell>
        <mxCell id="n42" value="&lt;b&gt;Per-tenant budget meter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reserve-before / commit-after · hard cap fails closed&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#2f4858&quot;&gt;✓ VERIFIED LIVE · BUD_budget_proof&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fillColor=#d5e8d4;strokeColor=#4d7c3a;" vertex="1" parent="1"><mxGeometry x="1150" y="864" width="430" height="62" as="geometry"/></mxCell>
