        <mxCell id="n57" value="request / approve sign-off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#43536b;" edge="1" parent="1" source="n24" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n58" value="one aegis.call per invocation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#43536b;" edge="1" parent="1" source="n24" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n59" value="verify_source, through the gateway target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2;" edge="1" parent="1" source="n22" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n60" value="get_workload_access_token → get_resource_oauth2_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n61" value="M2M bearer — never stored in the tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2;" edge="1" parent="1" source="n29" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n62" value="Authorization: Bearer …" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2;" edge="1" parent="1" source="n28" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n63" value="authoritative record, or 401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2;" edge="1" parent="1" source="n30" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n64" value="fetch JWKS · verify RS256 signature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2;" edge="1" parent="1" source="n30" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n65" value="what would replace it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;dashed=1;labelBackgroundColor=#ffffff;strokeColor=#a11;" edge="1" parent="1" source="n31" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n66" value="THE RULE THIS DIAGRAM OBEYS&lt;br&gt;&lt;br&gt;Measure the artifact, not the source.&lt;br&gt;&lt;br&gt;Every green box was read back from AWS after the&lt;br&gt;run, or from the synthesized template - never from&lt;br&gt;the code that was supposed to produce it. Three&lt;br&gt;separate defects in this build were invisible in&lt;br&gt;the source and obvious in the artifact: users the&lt;br&gt;IaC path never creates, an authorizer that trusts&lt;br&gt;exactly one client, and a Lambda environment left&lt;br&gt;empty because a label contained a comma." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8d5;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="330" height="250" as="geometry"/></mxCell>
        <mxCell id="n67" value="WHAT THE OUTBOUND LEG COST&lt;br&gt;&lt;br&gt;CONN-1 took six from-zero live runs. Not one of&lt;br&gt;the six failures was where it appeared to be:&lt;br&gt;&lt;br&gt;  fpa  authentication - proof users the CDK&lt;br&gt;       path never creates&lt;br&gt;  fpb  the gateway - the authorizer allow-lists&lt;br&gt;       exactly ONE client&lt;br&gt;  fpd  no diagnosis at all - the error went&lt;br&gt;       to /dev/null&lt;br&gt;  fpe  the SoR trusted nothing - EXPECTED_ISS&lt;br&gt;       was empty; six retries failed silently&lt;br&gt;  fpf  proven, 21 of 21&lt;br&gt;&lt;br&gt;Each was hidden behind a silenced error path. CI&lt;br&gt;now fails when a new one appears." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8d5;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="330" height="250" as="geometry"/></mxCell>
        <mxCell id="n68" value="THE TWO SENTENCES THAT BELONG TOGETHER, AND SHOULD NEVER BE QUOTED APART&lt;br&gt;&lt;br&gt;The system of record is a REAL OAuth2 API with RS256/JWKS signature verification.   IT IS OURS.&lt;br&gt;&lt;br&gt;Proving the governed path reaches it is not proving a customer&#x27;s system of record has been governed.&lt;br&gt;connect_system_of_record stays stubbed in the manifest for exactly that reason. Standing this connector up&lt;br&gt;against our own mock took six live runs; a real integration adds the customer&#x27;s IdP, network boundary, token&lt;br&gt;lifetimes and change control on top of that. The governance is reusable. The integration is engineering work." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8d5;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="1030" width="700" height="130" as="geometry"/></mxCell>
        <mxCell id="n69" value="ON DENY-BY-DEFAULT&lt;br&gt;&lt;br&gt;Step 3 of the connector proof denies an outsider, and&lt;br&gt;the denial NAMES require_tenant - a specific policy.&lt;br&gt;An earlier run denied the outsider and the legitimate&lt;br&gt;reviewer with the same string. &#x27;Outsider denied&#x27; proved&lt;br&gt;nothing then, because everything was denied.&lt;br&gt;&lt;br&gt;A deny-by-default claim is only evidence when the&lt;br&gt;denial is selective." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8d5;strokeColor=#d6b656;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="1030" width="470" height="130" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
