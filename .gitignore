# Build + machine state — never commit
*-state.env
.build/
.work/
*.log
_b_*.log

# Runtime deploy artifacts (regenerated by the toolkit)
.bedrock_agentcore/
.bedrock_agentcore.yaml
lib/runtime/ssm-pol.json

# Python venvs / caches
.venv/
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Rendered doc byproducts
docs/*.pdf
*.jpg

# Node deps for docs/generators
node_modules/

cdk/cdk.out/
cdk.out/
cdk/cdk.out-*/
cdk.out-*/

# Independent-verification run output � produced by the VERIFIER on their account,
# attached to their signed result. Never shipped by the author.
evidence/independent-verification-report.json

# live-gate scratch (unredacted account ids / driver sentinels) - never commit
cdk/outputs-*.json
evidence/OPERATOR-CONSOLE-*-LIVE.html
evidence/*.done
evidence/*.log

# L40: proof stdout/stderr sidecars. They are progress noise ("settling 150s for spans/logs...")
# or byte-for-byte duplicates of the .json beside them, they are never redacted because nothing
# reads them, and `git add -A evidence` swept 258 unredacted account ids into the index from them
# in one command. The evidence is the .json/.md; these are not evidence.
evidence/*.stdout
evidence/*.err
